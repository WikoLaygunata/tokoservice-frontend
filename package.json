		"@tiptap/extension-image": "^2.1.15",
		"@tiptap/extension-link": "^2.1.15",
		"@tiptap/extension-task-item": "^2.1.15",
		"@tiptap/extension-task-list": "^2.1.15",
		"@tiptap/extension-text-align": "^2.1.15",
		"@tiptap/extension-underline": "^2.1.15",
		"@tiptap/pm": "^2.1.15",
		"@tiptap/starter-kit": "^2.1.15",
		"@tiptap/vue-3": "^2.11.5",
		"@vueuse/components": "^10.7.1",
		"@vueuse/core": "^10.7.1",
		"axios": "^1.6.7",
		"browser-image-compression": "^2.0.2",
		"colord": "^2.9.3",
		"dayjs": "^1.11.10",
		"detect-touch-device": "^1.1.6",
		"file-saver": "^2.0.5",
		"highlight.js": "^11.9.0",
		"jsbarcode": "3",
